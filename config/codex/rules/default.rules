prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["gofmt", "-w"], decision="allow")
prefix_rule(pattern=["go", "test"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "rg \"func IoctlGetInt|TIOCGPGRP\" $(go env GOPATH)/pkg/mod/golang.org/x/sys* -n"], decision="allow")
prefix_rule(pattern=["go", "env"], decision="allow")
prefix_rule(pattern=["go", "build"], decision="allow")
prefix_rule(pattern=["rm", "youtube-downloader"], decision="allow")
prefix_rule(pattern=["go", "mod"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "go run ./cmd/youtube-downloader/main.go http://example.com/watch?v=x&t=1"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "noglob go run ./cmd/youtube-downloader/main.go http://example.com/watch?v=x&t=1"], decision="allow")
prefix_rule(pattern=["bun", "install"], decision="allow")
prefix_rule(pattern=["bun", "run", "test"], decision="allow")
prefix_rule(pattern=["bun", "run", "build"], decision="allow")
