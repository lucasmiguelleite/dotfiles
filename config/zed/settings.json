// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "cli_default_open_behavior": "new_window",
  "indent_guides": {
    "enabled": true,
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "inlay_hints": {
    "enabled": false,
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
    },
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "project_panel": {
    "dock": "left",
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enabled": false,
  },
  "buffer_font_fallbacks": [
    "Fira Code",
    "fira-code-nerd",
    "FiraCode Nerd Font",
    "Consolas",
    "Courier New",
    "monospace",
  ],
  "buffer_font_family": "MesloLGS NF",
  "file_types": {
    "typescriptreact": ["*.tsx"],
  },
  "tab_size": 2,
  "session": {
    "trust_all_worktrees": false,
  },
  "vim_mode": true,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Everforest Dark Hard (material)",
  },
}
